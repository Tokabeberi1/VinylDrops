{
  "name": "NewsPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "excerpt": {
      "type": "string",
      "title": "Excerpt"
    },
    "content": {
      "type": "string",
      "title": "Content (HTML)"
    },
    "cover_image": {
      "type": "string",
      "title": "Cover Image URL"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "release",
        "news",
        "review",
        "exclusive",
        "interview",
        "guide"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tags"
    },
    "author_name": {
      "type": "string",
      "title": "Author Name"
    },
    "is_featured": {
      "type": "boolean",
      "title": "Featured"
    },
    "is_published": {
      "type": "boolean",
      "title": "Published"
    },
    "published_at": {
      "type": "string",
      "title": "Published At"
    },
    "views": {
      "type": "number",
      "title": "Views"
    }
  },
  "required": [
    "title",
    "content"
  ]
}